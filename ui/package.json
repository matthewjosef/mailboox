    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@holochain/client": "^0.21.0",
    "@msgpack/msgpack": "^2.8.0",
    "@theweave/api": "0.7.0-dev.5",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/leaflet": "1.9.20",
    "bestzip": "^2.2.1",
    "jsdom": "26.1.0",
    "rimraf": "^5.0.10",
    "svelte": "^5.0.0",
    "svelte-check": "4.7.6",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3",
    "vite": "^6.2.5",
    "vitest": "3.2.7"
  },
  "type": "module"
}
